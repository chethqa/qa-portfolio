{
  "info": {
    "_postman_id": "7b4d2a6e-qa-portfolio-demo-collection",
    "name": "QA Portfolio - REST API Practice",
    "description": "Practice collection using JSONPlaceholder, a public fake REST API. Write operations are simulated and generally do not persist.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    },
    {
      "key": "postId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET - List posts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Response is JSON array', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "pm.test('First item has expected fields when present', () => { const b = pm.response.json(); if (b.length) { pm.expect(b[0]).to.have.property('id'); pm.expect(b[0]).to.have.property('title'); pm.expect(b[0]).to.have.property('userId'); } });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Single post",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returned ID matches requested ID', () => pm.expect(String(pm.response.json().id)).to.eql(pm.variables.get('postId')));",
              "pm.test('Title is a string', () => pm.expect(pm.response.json().title).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Create post (simulated)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"QA portfolio practice post\",\n  \"body\": \"Example payload for API testing\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
              "pm.test('Response includes submitted title', () => pm.expect(pm.response.json().title).to.eql('QA portfolio practice post'));",
              "pm.test('Response includes an ID', () => pm.expect(pm.response.json()).to.have.property('id'));"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - Update post (simulated)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated by QA portfolio\",\n  \"body\": \"Updated example payload\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Updated title is returned', () => pm.expect(pm.response.json().title).to.eql('Updated by QA portfolio'));"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - Delete post (simulated)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/{{postId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Negative - Missing post",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/posts/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "999999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}